---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import FullScreen from "../../layouts/FullScreen.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<FullScreen title="Blog" description="Check out my writings">
    <section>
        <ul>
            {
                posts.map((post) => (
                    <li>
                        <a href={`/blog/${post.id}/`}>
                            <h4 class="text-white font-bold text-3xl mb-2">{post.data.title}</h4>
                            <p class="text-white text-sm text-slate-800 mb-4">
                                <FormattedDate date={post.data.pubDate} />
                            </p>
                            {post.data.heroImage && (
                                <Image
                                    width={720}
                                    height={360}
                                    src={post.data.heroImage}
                                    alt=""
                                    loading="eager"
                                />
                            )}
                        </a>
                    </li>
                ))
            }
        </ul>
    </section>
</FullScreen>
