---
import FullScreen from "../layouts/FullScreen.astro";

import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<FullScreen title="About" description="About me">
    <div class="flex flex-col ">
        <p class="text-xl md:text-2xl text-white drop-shadow-md mt-4">
            My name is Rannien. I'm a web developer @Hungary
        </p>

        <div
            class="mt-8 bg-white/10 backdrop-blur-sm p-6 rounded-lg border text-center border-white/20 max-w-2xl"
        >
            <p class="text-lg md:text-xl text-white mb-4">
                Passionate about creating useful and optimized websites and
                webapps with modern technologies and creativity.
            </p>

            <div
                class="flex flex-col sm:flex-row text-center justify-center gap-4 mt-6"
            >
                <span class="px-3 py-1 bg-white/20 rounded-full text-white"
                    >Tailwind CSS</span
                >
                <span class="px-3 py-1 bg-white/20 rounded-full text-white"
                    >Vue.js</span
                >
                <span class="px-3 py-1 bg-white/20 rounded-full text-white"
                    >Nuxt</span
                >
            </div>

            <a
                href="/projects"
                class="mt-8 bg-white/20 hover:bg-white/30 text-white font-semibold py-2 px-6 rounded-lg backdrop-blur-sm transition-all border border-white/20 cursor-pointer inline-block"
            >
                See My Work
            </a>
        </div>
    </div>
</FullScreen>
